{
  "name": "ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "orval --config ./orval.config.ts && vite",
    "build": "orval --config ./orval.config.ts && tsc -b && vite build",
    "generate-api": "cargo run --example wanaku-openapi --manifest-path ../../server/Cargo.toml --no-default-features > openapi.json && orval --config ./orval.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "preview": "vite preview"
  },
  "resolutions": {
    "jsonpath-plus": "10.4.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "postcss": "8.5.23",
    "ip-address": "10.7.1",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.76.0",
    "@carbon/layout": "^11.49.0",
    "@carbon/react": "^1.103.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.18.0",
    "sass": "^1.98.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "orval": "^8.22.0",
    "prettier": "3.5.3",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.4.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.18.0"
  }
}
