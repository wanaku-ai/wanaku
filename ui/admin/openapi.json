  "components": {
    "schemas": {
      "DecisionSnapshot": {
        "type": "object",
        "required": [
          "pass",
          "block",
          "reject_malformed",
          "warn",
          "filter_tools",
          "set_metadata"
        ],
        "properties": {
          "block": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "filter_tools": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "pass": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reject_malformed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "set_metadata": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "warn": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "DurationSnapshot": {
        "type": "object",
        "required": [
          "count",
          "total_ms",
          "avg_ms"
        ],
        "properties": {
          "avg_ms": {
            "type": "number",
            "format": "double"
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_ms": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "EvaluatorSnapshot": {
        "type": "object",
        "required": [
          "decisions",
          "llm",
          "schema",
          "wasm",
          "pipeline_duration"
        ],
        "properties": {
          "decisions": {
            "$ref": "#/components/schemas/DecisionSnapshot"
          },
          "llm": {
            "$ref": "#/components/schemas/LlmSnapshot"
          },
          "pipeline_duration": {
            "$ref": "#/components/schemas/DurationSnapshot"
          },
          "schema": {
            "$ref": "#/components/schemas/SchemaSnapshot"
          },
          "wasm": {
            "$ref": "#/components/schemas/WasmSnapshot"
          }
        }
      },
      "FilterSnapshot": {
        "type": "object",
        "required": [
          "requests_continue",
          "requests_reject",
          "requests_other",
          "errors",
          "duration"
        ],
        "properties": {
          "duration": {
            "$ref": "#/components/schemas/DurationSnapshot"
          },
          "errors": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "requests_continue": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "requests_other": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "requests_reject": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ForwardEntry": {
        "type": "object",
        "required": [
          "name",
          "address"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          },
          "serverInfo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/McpServerInfo"
              }
            ]
          },
          "statusMessage": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GaugeSnapshot": {
        "type": "object",
        "required": [
          "evaluators_loaded",
          "wasm_compiled",
          "namespace_bindings"
        ],
        "properties": {
          "evaluators_loaded": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "namespace_bindings": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "wasm_compiled": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Interaction": {
        "type": "object",
        "required": [
          "epoch_ms",
          "path",
          "request_body",
          "response_body",
          "status_code",
          "duration_ms"
        ],
        "properties": {
          "completion_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "epoch_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "request_body": {},
          "response_body": {},
          "status_code": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "LlmSnapshot": {
        "type": "object",
        "required": [
          "calls_success",
          "calls_failure",
          "empty_results",
          "duration"
        ],
        "properties": {
          "calls_failure": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "calls_success": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "duration": {
            "$ref": "#/components/schemas/DurationSnapshot"
          },
          "empty_results": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "McpServerInfo": {
        "type": "object",
        "required": [
          "serverName",
          "version"
        ],
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "serverName": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "websiteUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MetricsSnapshot": {
        "type": "object",
        "required": [
          "filters",
          "evaluators",
          "pipeline",
          "gauges"
        ],
        "properties": {
          "evaluators": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/EvaluatorSnapshot"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/FilterSnapshot"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "gauges": {
            "$ref": "#/components/schemas/GaugeSnapshot"
          },
          "pipeline": {
            "$ref": "#/components/schemas/PipelineSnapshot"
          }
        }
      },
      "NamespaceEntry": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "audience": {
            "type": [
              "string",
              "null"
            ]
          },
          "authRequired": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "PipelineSnapshot": {
        "type": "object",
        "required": [
          "trigger_matches",
          "trigger_misses",
          "skipped_no_method",
          "skipped_no_state",
          "skipped_no_match",
          "skipped_no_registry",
          "skipped_no_interactions"
        ],
        "properties": {
          "skipped_no_interactions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "skipped_no_match": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "skipped_no_method": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "skipped_no_registry": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "skipped_no_state": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "trigger_matches": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "trigger_misses": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "PromptArgument": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "PromptEntry": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "arguments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptArgument"
            }
          },
          "configurationURI": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptMessage"
            }
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PromptMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "content": {},
          "role": {
            "$ref": "#/components/schemas/PromptRole"
          }
        }
      },
      "PromptRole": {
        "type": "string",
        "enum": [
          "user",
          "assistant",
          "system"
        ]
      },
      "ResourceEntry": {
        "type": "object",
        "required": [
          "name",
          "location",
          "type"
        ],
        "properties": {
          "configurationURI": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
