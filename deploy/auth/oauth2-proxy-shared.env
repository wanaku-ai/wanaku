# Shared config for both oauth2-proxy instances.
# Both use the same cookie secret for SSO across ports.

OAUTH2_PROXY_PROVIDER=keycloak-oidc
# this must be the publicly accessible keycloak url with the realm name
OAUTH2_PROXY_OIDC_ISSUER_URL=http://localhost:8543/realms/wanaku
OAUTH2_PROXY_CLIENT_ID=wanaku-mcp-router
# Compose reads OAUTH2_PROXY_CLIENT_SECRET from the shell. See README.md.
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256

# since keycloak public and internal url may differ we have to skip the discovery
# and manually set the following properties
OAUTH2_PROXY_SKIP_OIDC_DISCOVERY=true
# from http://my-keycloak:8543/realms/wanaku/.well-known/openid-configuration
# authorization_endpoint property (public url)
OAUTH2_PROXY_LOGIN_URL=http://localhost:8543/realms/wanaku/protocol/openid-connect/auth
# token_endpoint (internal network)
OAUTH2_PROXY_REDEEM_URL=http://keycloak:8080/realms/wanaku/protocol/openid-connect/token
# jwks_uri (internal network)
OAUTH2_PROXY_OIDC_JWKS_URL=http://keycloak:8080/realms/wanaku/protocol/openid-connect/certs

# Cookie config — same secret enables SSO across both instances.
# Compose reads OAUTH2_PROXY_COOKIE_SECRET from the shell. See README.md.
OAUTH2_PROXY_COOKIE_NAME=_oauth2_proxy
OAUTH2_PROXY_COOKIE_SECURE=false

# Pass identity headers and bearer tokens to upstream
OAUTH2_PROXY_SKIP_JWT_BEARER_TOKENS=true
OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
