# Management proxy — authenticates admin UI and REST API access
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=http://wanaku-server:8080
OAUTH2_PROXY_REDIRECT_URL=http://localhost:4180/oauth2/callback

# Accept tokens from MCP clients (audience may differ from our client-id)
OAUTH2_PROXY_OIDC_EXTRA_AUDIENCES=mcp-client,wanaku-mcp-client

# Public paths that skip authentication
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/healthz$,^/health$

# Return 401 for API clients instead of an HTML login redirect.
OAUTH2_PROXY_API_ROUTES=^/api/.*

# Allow users with unverified email addresses
OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=true

# Restrict to admin role (requires Keycloak role mapping)
# OAUTH2_PROXY_ALLOWED_ROLES=admin
