(component
  (import "wanaku:tool-handler/catalog@1.0.0" (instance $mcp
    (type $json string)
    (type $host-error (record (field "kind" string) (field "message" string) (field "code" (option s32))))
    (export "host-error" (type $import-error (eq $host-error)))
    (export "json" (type $import-json (eq $json)))
    (export "get-tool" (func (param "namespace" string) (param "name" string) (result (result $import-json (error $import-error)))))))
  (alias export $mcp "host-error" (type $host-error))
  (alias export $mcp "json" (type $json))
  (alias export $mcp "get-tool" (func $get-tool))
  (core module $allocator
    (memory (export "memory") 2)
    (data (i32.const 128) "TARGET_NAMESPACE")
    (data (i32.const 256) "TARGET_NAME")
    (data (i32.const 512) "\7b\22\63\6f\6e\74\65\6e\74\22\3a\5b\5d\2c\22\73\74\72\75\63\74\75\72\65\64\43\6f\6e\74\65\6e\74\22\3a")
    (global $next (mut i32) (i32.const 4096))
    (func (export "realloc") (param i32 i32 i32) (param $size i32) (result i32)
      (local $pointer i32)
      (local.set $pointer (global.get $next))
      (global.set $next (i32.and (i32.add (i32.add (global.get $next) (local.get $size)) (i32.const 7)) (i32.const -8)))
      (local.get $pointer)))
  (core instance $allocator-instance (instantiate $allocator))
  (alias core export $allocator-instance "memory" (core memory $memory))
  (alias core export $allocator-instance "realloc" (core func $realloc))
  (core func $call (canon lower (func $get-tool) (memory $memory) (realloc $realloc)))
  (core instance $host (export "call" (func $call)))
  (core module $handler
    (import "allocator" "memory" (memory 2))
    (import "allocator" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "host" "call" (func $call (param i32 i32 i32 i32 i32)))
    (func (export "handle") (param i32 i32 i32 i32) (param $arguments i32) (param $length i32) (result i32)
      (local $pointer i32) (local $size i32)
      (call $call (i32.const 128) (i32.const NAMESPACE_LENGTH) (i32.const 256) (i32.const NAME_LENGTH) (i32.const 0))
      (if (i32.eqz (i32.load (i32.const 0)))
        (then
          (local.set $size (i32.add (i32.load (i32.const 8)) (i32.const 35)))
          (local.set $pointer (call $realloc (i32.const 0) (i32.const 0) (i32.const 1) (local.get $size)))
          (memory.copy (local.get $pointer) (i32.const 512) (i32.const 34))
          (memory.copy (i32.add (local.get $pointer) (i32.const 34)) (i32.load (i32.const 4)) (i32.load (i32.const 8)))
          (i32.store8 (i32.sub (i32.add (local.get $pointer) (local.get $size)) (i32.const 1)) (i32.const 125))
          (i32.store (i32.const 4) (local.get $pointer))
          (i32.store (i32.const 8) (local.get $size))))
      (i32.const 0)))
  (core instance $instance (instantiate $handler (with "host" (instance $host)) (with "allocator" (instance $allocator-instance))))
  (alias core export $instance "handle" (core func $handle))
  (type $request (record (field "namespace" string) (field "name" string) (field "arguments" string)))
  (export $public-json "json" (type $json))
  (export $public-error "host-error" (type $host-error))
  (export $public-request "request" (type $request))
  (func (export "handle") (param "request" $public-request) (result (result $public-json (error $public-error)))
    (canon lift (core func $handle) (memory $memory) (realloc $realloc))))
